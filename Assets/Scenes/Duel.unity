  m_Name: 
  m_EditorClassIdentifier: Unity.Rea.QuickDuel.Runtime::Unity.Rea.QuickDuel.DuelView
  arenas:
  - id: desert
    name: Wastes of Nod
    description: A dry and arid land where only brigands and daemons make their home.
    sprite: {fileID: 21300000, guid: 2a9c3ba3c7d1a294f9c9b595a9407248, type: 3}
    ambient: sand
  - id: pastelfields
    name: Pastel Fields
    description: A picturesque country vista far removed from the machinations of
      the world.
    sprite: {fileID: 21300000, guid: 9412c3340c1d69548af226d8494073ce, type: 3}
    ambient: butterfly
  - id: snow
    name: Frozen Tundra
    description: A frigid pass through the otherwise treacherous northern mountains.
    sprite: {fileID: 21300000, guid: c34f6190ca23d234e901b720f88f2648, type: 3}
    ambient: snow
  - id: fumaroles
    name: The Fumaroles
    description: An area of hot springs which bubble up from the magma heated underground
      rivers.
    sprite: {fileID: 21300000, guid: 8fc2cc954e08d72499855c595347cb45, type: 3}
    ambient: fog
  - id: dustyjunction
    name: Dusty Junction
    description: 'A rundown mass transit depot, it was once the epicenter of travel,

      now
      it''s mearly a road marker on the way to other locales.'
    sprite: {fileID: 21300000, guid: 48f45e1038b2c7a4c81c83f0a0b3cb89, type: 3}
    ambient: none
  - id: sozzaspoint
    name: Sozza's Point
    description: A rocky coastal vista that was once home to the legendary swordmaster,
      Sozza.
    sprite: {fileID: 21300000, guid: d6d111481897f5c4484c434e2a8fcce9, type: 3}
    ambient: none
  - id: southridge
    name: South Ridge
    description: A lush valley located in the shadow of a stone ridge.
    sprite: {fileID: 21300000, guid: f64b6a1ecde02cf4481979c8bce231ad, type: 3}
    ambient: none
  - id: aridplains
    name: Arid Plains
    description: A remote grassland with little of civilization within it's expanses.
    sprite: {fileID: 21300000, guid: 786a58311b4a87d43b0be9652df187c5, type: 3}
    ambient: fly
  - id: interiorsea
    name: Interior Sea
    description: 'A large land locked salty body of water, it once had a thriving
      summer community.

      When the aristocracy collapsed, the resort community
      encircling the sea became a ghost town.'
    sprite: {fileID: 21300000, guid: 8f7a177f1eecaab45886ac64c1492230, type: 3}
    ambient: none
  - id: pineforest
    name: Tu'verone Forest
    description: A coniferous forest.
    sprite: {fileID: 21300000, guid: d97cfb25270538442a78e63e20b453cd, type: 3}
    ambient: none
  - id: farmland
    name: Harvest Cresent
    description: A fertile farmland.
    sprite: {fileID: 21300000, guid: 6fffaafb098e36e4581d43bb7ea4172d, type: 3}
    ambient: none
