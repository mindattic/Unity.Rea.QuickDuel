<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Unity.Rea.QuickDuel.Core.Tests</AssemblyName>
    <RootNamespace>Unity.Rea.QuickDuel.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shipped tuning file, so the tests run on the very figures the game ships with. -->
    <Content Include="../../Assets/StreamingAssets/Settings/tuning.json" Link="Settings/tuning.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Unity.Rea.QuickDuel.Core/Unity.Rea.QuickDuel.Core.csproj" />
  </ItemGroup>
</Project>
